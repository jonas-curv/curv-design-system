{
  "name": "@curvgroup/design-system",
  "version": "0.2.22",
  "private": true,
  "description": "Curv shared design system \u2014 components, theme tokens, and Claude Code skills used across all Curv OS apps.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "theme.css",
    "eslint",
    "skills",
    "agents",
    "docs",
    "mobile.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./eslint": "./eslint/index.js",
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "import": "./dist/mobile.js",
      "default": "./dist/mobile.js"
    },
    "./mobile.css": "./mobile.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "prepare": "tsup",
    "watch": "tsup --watch",
    "site:build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/mobile.test.mjs"
  },
  "peerDependencies": {
    "jspdf": "*",
    "jspdf-autotable": "*",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "jspdf": {
      "optional": true
    },
    "jspdf-autotable": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-virtual": "^3.14.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "react-day-picker": "^10.0.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.18.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.25.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8",
    "typescript": "^5",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.1.5"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
